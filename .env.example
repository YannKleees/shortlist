# Copy to .env and fill in what you use. .env is ignored by git.

# Letters and the deep CV review. With a Claude key Shortlist uses Claude; without one, Ollama on this computer.
# ANTHROPIC_API_KEY=
# SHORTLIST_LETTER_MODEL=claude-opus-5-5
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# The address people use to reach Shortlist once it is online, for invite links and the iPhone share button.
# SHORTLIST_PUBLIC_URL=https://shortlist.example.com
